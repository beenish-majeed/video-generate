# ==============================================================================
# Video Studio Backend - Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Server Security & API Key
# In production, API_KEY must be a high-entropy secret (min 16 chars).
API_KEY=dev_secret_key_123456789
ALLOW_INSECURE_DEV=true

# Anonymous Session HMAC Signing Secret
# In production, SESSION_SECRET must be explicitly set to a 32+ char secret.
SESSION_SECRET=insecure_dev_session_secret_change_in_production_min32chars

# Reverse Proxy & Network Security
# List of trusted reverse proxy IP addresses. Requests from these IPs may pass
# X-Forwarded-For, X-Forwarded-Proto, etc.
TRUSTED_PROXIES=["127.0.0.1", "::1", "testclient"]
ENFORCE_HTTPS=false

# ------------------------------------------------------------------------------
# Optional Cloud AI Video Generation Providers
# Leave blank to use 100% offline local procedural synthesis (Ken Burns / Cards)
# ------------------------------------------------------------------------------

# Google Veo 3 / Google GenAI Video Provider
GEMINI_API_KEY=
GOOGLE_API_KEY=

# fal.ai / Minimax Video Provider
FAL_KEY=

# File.ai API Integration
FILE_AI_API_KEY=
FILE_AI_BASE_URL=https://api.file.ai/v1
FILE_AI_TIMEOUT_SECONDS=60.0
FILE_AI_MAX_RETRIES=3

# Storage & Processing
STORAGE_DIR=./storage
MAX_ACTIVE_JOBS_CAP=16
MAX_REQUEST_BODY_BYTES=57671680      # 55 MB
MAX_CLIP_REQUEST_BODY_BYTES=225443840 # 215 MB
