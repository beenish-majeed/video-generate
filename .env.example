# ==============================================================================
# Video Studio Backend - Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Server Security & API Key
# In production, API_KEY must be at least 16 characters and ALLOW_INSECURE_DEV must be false.
API_KEY=dev_secret_key_123456789
ALLOW_INSECURE_DEV=true

# Anonymous Session HMAC Signing Secret
# In production, SESSION_SECRET must be set to at least 32 characters.
SESSION_SECRET=insecure_dev_session_secret_change_in_production_min32chars

# Reverse Proxy & Network Security
# List ONLY exact trusted proxy IP addresses (do NOT add entire private CIDR subnets
# unless every host on that subnet is a trusted reverse proxy).
TRUSTED_PROXIES=["127.0.0.1", "::1", "testclient"]
ENFORCE_HTTPS=false

# ------------------------------------------------------------------------------
# Video Generation Provider
# Default is "slideshow" (100% local/offline Ken Burns + Wav2Lip when installed).
# Cloud providers ("google_veo", "fal_ai", or "auto") are paid, optional, and
# not tested end-to-end; leave VIDEO_PROVIDER=slideshow for zero network calls.
# ------------------------------------------------------------------------------
VIDEO_PROVIDER=slideshow

# Optional Paid Cloud Providers (only used when VIDEO_PROVIDER != slideshow)
GEMINI_API_KEY=
GOOGLE_API_KEY=
FAL_KEY=

# Optional File.ai API Integration
FILE_AI_API_KEY=
FILE_AI_BASE_URL=https://api.file.ai/v1
FILE_AI_TIMEOUT_SECONDS=60.0
FILE_AI_MAX_RETRIES=3

# Storage & Processing
STORAGE_DIR=./storage
MAX_ACTIVE_JOBS_CAP=16
MAX_REQUEST_BODY_BYTES=57671680       # 55 MB
MAX_CLIP_REQUEST_BODY_BYTES=225443840 # 215 MB
